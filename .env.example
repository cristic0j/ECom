# Database
DATABASE_URL=postgresql://ecom:ecom@localhost:5433/ecom?schema=public

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# Seeded admin (used by pnpm db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# Media storage: "local" (files saved to apps/api/uploads, served by the API) or "s3"
STORAGE_DRIVER=local
# Only used when STORAGE_DRIVER=s3 (works with AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api
