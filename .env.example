# Database
DATABASE_URL=postgresql://ecom:ecom@localhost:5433/ecom?schema=public

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Production refuses this placeholder; generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Seeded admin (used by pnpm db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
# Set to false for a real store: the seed then creates only the admin user, without demo products
SEED_DEMO=true

# Media storage: "local" (files saved to apps/api/uploads, served by the API) or "s3"
STORAGE_DRIVER=local
# Only used when STORAGE_DRIVER=s3 (works with AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Email: "console" prints emails in the API terminal (local dev); "resend" sends them (https://resend.com)
EMAIL_DRIVER=console
RESEND_API_KEY=
# Sender address; with Resend its domain must be verified first
EMAIL_FROM="Demo Store <orders@example.com>"
# Optional: where customer replies go (defaults to the sender)
EMAIL_REPLY_TO=
# Optional, comma-separated: who gets "new order" alerts (defaults to every ADMIN user)
ORDER_NOTIFY_EMAIL=

# Card payments (only needed with features.payments: true in store.config.ts); see README → Card payments
# Locally: sk_test_… from the Stripe dashboard, and the whsec_… printed by `stripe listen`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web: where the Next server reaches the API (server-side fetches + /api proxy)
API_INTERNAL_URL=http://localhost:4000
# Public URL of the storefront (sitemap, canonical URLs, links in emails)
SITE_URL=http://localhost:3000
