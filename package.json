{
  "name": "ecom-template",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @ecom/db migrate",
    "db:seed": "pnpm --filter @ecom/db seed",
    "db:studio": "pnpm --filter @ecom/db studio",
    "stripe:login": ".tools/stripe login",
    "stripe:listen": ".tools/stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired --forward-to localhost:4000/api/payments/webhook"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
