generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AdminRole {
  ADMIN
  EDITOR
}

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  products    ProductCategory[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  description String            @default("")
  status      ProductStatus     @default(DRAFT)
  /// Store-defined custom fields, e.g. { "material": "cotton" }
  attributes  Json              @default("{}")
  /// Denormalized lowest variant price, kept in sync on write; used for sort/filter
  priceMinMinor Int             @default(0)
  variants    ProductVariant[]
  images      ProductImage[]
  categories  ProductCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([priceMinMinor])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductVariant {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String         @unique
  title          String         @default("Default")
  /// Price in minor units (cents); currency comes from store settings
  priceMinor     Int
  compareAtMinor Int?
  /// Option values, e.g. { "size": "M", "color": "Red" }
  options        Json           @default("{}")
  isDefault      Boolean        @default(false)
  position       Int            @default(0)
  images         ProductImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([productId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  url       String
  alt       String          @default("")
  position  Int             @default(0)
  createdAt DateTime        @default(now())

  @@index([productId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String    @default("")
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

/// Storefront shopper. Separate from AdminUser, with its own auth cookie.
model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  cart         Cart?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A guest cart is found by `token` (cookie); a customer's cart by `customerId`. Guest carts merge in at login.
model Cart {
  id         String     @id @default(cuid())
  token      String     @unique
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Order {
  id              String      @id @default(cuid())
  /// Human-facing order number, e.g. #1001
  number          Int         @unique @default(autoincrement())
  /// Secret for viewing the order without an account (guest confirmation link)
  accessToken     String      @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email           String
  status          OrderStatus @default(PENDING)
  currency        String
  subtotalMinor   Int
  shippingMinor   Int
  totalMinor      Int
  /// Snapshot of the address at purchase time
  shippingAddress Json
  note            String      @default("")
  items           OrderItem[]
  events          OrderEvent[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

/// Line items snapshot title, sku and price so later catalog edits never change past orders.
model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitle   String
  variantTitle   String
  sku            String
  unitPriceMinor Int
  quantity       Int
  lineTotalMinor Int

  @@index([orderId])
  @@index([variantId])
}

/// Status history: who changed what, and when.
model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  /// Admin email, or "customer" / "system"
  actor      String
  note       String       @default("")
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
